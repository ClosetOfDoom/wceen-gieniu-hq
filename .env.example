# Frontend (Vite) — safe to expose, anon key is RLS-limited
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server side (Netlify Functions + scripts) — NEVER commit real values
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Meta Ads ingest (src/lib/meta/insights.ts)
# System-user token, non-expiring, scopes: ads_read + business_management
META_ACCESS_TOKEN=
# Ad account id, with or without the act_ prefix
META_AD_ACCOUNT_ID=
# Optional — Graph API version. Defaults to v21.0 in code; set once the current
# stable version is confirmed against Meta's changelog.
META_GRAPH_VERSION=

# LLM
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
ELEVENLABS_OUTPUT_FORMAT=

# ClickMeeting (scripts/clickmeeting-attendance.mjs)
CLICKMEETING_API_KEY=
SUPABASE_SERVICE_ROLE=
