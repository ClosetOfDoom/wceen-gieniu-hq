    "assert:tts": "node scripts/assert-tts.mjs",
    "assert:webinar": "node scripts/assert-webinar.mjs",
    "assert:orders": "node scripts/assert-orders.mjs",
    "assert:campaigns": "node scripts/assert-campaigns.mjs",
    "assert:nav": "node scripts/assert-nav.mjs",
    "assert:data-contract": "node scripts/assert-data-contract.mjs",
    "assert:ops-week-report": "node scripts/assert-ops-week-report.mjs",
    "assert:webinar-schedule": "node scripts/assert-webinar-schedule.mjs",
    "assert:price-classification": "node scripts/assert-price-classification.mjs",
    "assert:data-sources": "node scripts/assert-data-sources.mjs",
    "assert:tts-fallback": "node scripts/assert-tts-fallback.mjs",
    "assert:profit-metrics": "node scripts/assert-profit-metrics.mjs",
